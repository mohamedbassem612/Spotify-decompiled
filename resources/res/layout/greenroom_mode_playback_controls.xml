<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/playback_controls_container"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:animateLayoutChanges="true"
    android:layoutDirection="ltr">
    <com.spotify.encoremobile.viewstub.EncoreViewStub
        android:id="@+id/shuffle_button"
        android:visibility="invisible"
        android:layout_width="0x7f07078f"
        android:layout_height="0x7f07078f"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.spotify.encoremobile.viewstub.EncoreViewStub
        android:id="@+id/previous_button"
        android:layout_width="0x7f0706ec"
        android:layout_height="0x7f0706ec"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_bias="@fraction/left_secondary_button_horizontal_bias"
        app:layout_constraintLeft_toRightOf="@+id/shuffle_button"
        app:layout_constraintRight_toLeftOf="@+id/play_pause_button"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.spotify.encoremobile.viewstub.EncoreViewStub
        android:id="@+id/play_pause_button"
        android:layout_width="0x7f070697"
        android:layout_height="0x7f070697"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.spotify.encoremobile.viewstub.EncoreViewStub
        android:id="@+id/next_button"
        android:layout_width="0x7f0706ec"
        android:layout_height="0x7f0706ec"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_bias="@fraction/right_secondary_button_horizontal_bias"
        app:layout_constraintLeft_toRightOf="@+id/play_pause_button"
        app:layout_constraintRight_toLeftOf="@+id/repeat_button"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.spotify.encoremobile.viewstub.EncoreViewStub
        android:id="@+id/repeat_button"
        android:visibility="invisible"
        android:layout_width="0x7f07078f"
        android:layout_height="0x7f07078f"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
